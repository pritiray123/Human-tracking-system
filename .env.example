# Human Tracking System — Public Internet & STUN/TURN Environment Configuration

# Public Backend HTTPS Domain / Public Tunnel URL
PUBLIC_URL=https://shaky-lemons-arrive.loca.lt
# Public WebSocket Signaling URL (optional, derived from PUBLIC_URL if omitted)
SIGNALING_URL=wss://https://shaky-lemons-arrive.loca.lt/ws/signaling

# STUN Server (default: Google Public STUN)
STUN_URL=stun:stun.l.google.com:19302

# TURN Relay Server Configuration (Required for strict NAT / Mobile Data fallback)
TURN_URL=turn:YOUR_TURN_SERVER:3478
TURN_USERNAME=hts_user
TURN_PASSWORD=hts_secret_password

# FORCE_TURN test mode (set to true to force iceTransportPolicy: "relay" for verification)
FORCE_TURN=false
